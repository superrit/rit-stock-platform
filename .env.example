# ============================================================
# 股票量化交易平台 - 环境变量示例（占位值，请勿提交真实密钥）
# 复制为 .env.development / .env.production 并按环境填写真实值
# Nuxt 会在 dev 加载 .env.development，build/preview 加载 .env.production
# ============================================================

# ---- PostgreSQL ----
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=5432
NUXT_DB_USER=postgres
# 注意：含 # 等特殊字符的密码必须用引号包裹
NUXT_DB_PASSWORD="CHANGE_ME"
NUXT_DB_DATABASE=rit_stock_platform

# ---- Redis ----
NUXT_REDIS_HOST=127.0.0.1
NUXT_REDIS_PORT=6379
NUXT_REDIS_PASSWORD=
NUXT_REDIS_DB=0

# ---- JWT ----
# 登录令牌有效期（默认 1 天）
NUXT_JWT_EXPIRES_IN=1d
# 用于签发/校验 JWT 的密钥（务必替换为强随机值，如 openssl rand -hex 48）
NUXT_JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

# ---- 密码加盐（重要配置，用于 MD5 加盐）----
# 务必替换为强随机值（如 openssl rand -hex 32），一旦设置不可更改（否则所有密码失效）
NUXT_PASSWORD_SALT=CHANGE_ME_STRONG_RANDOM_SALT

# ---- RSA 核心私钥（PKCS8 PEM 的 base64，仅服务端，用于解密客户端 RSA 加密数据）----
# 生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
NUXT_RSA_PRIVATE_KEY=CHANGE_ME_RSA_PRIVATE_KEY_BASE64

# ---- 策略上报签名盐值（32 位，sign = MD5(ts + JSON.stringify(data) + 盐)）----
# 生成：openssl rand -hex 16
NUXT_SIGN_SALT=CHANGE_ME_32_CHAR_SIGN_SALT_XXXX

# ---- 上报防重放时间窗口（毫秒，默认 300000 = 5 分钟）----
NUXT_REPLAY_WINDOW_MS=300000

# ---- 策略查询缓存 TTL（秒，可选）----
# NUXT_STRATEGY_CACHE_META_TTL=600   # 维度下拉（directs/periods/dates）缓存，默认 600
# NUXT_STRATEGY_CACHE_LIST_TTL=120   # 列表结果缓存，默认 120
# NUXT_STRATEGY_CACHE_LOCK_TTL=10    # 单飞锁超时，默认 10

# ---- 会话 cookie Secure 属性 ----
# 仅当通过 HTTPS 提供服务时才设为 true；纯 HTTP 部署必须为 false，否则浏览器会拒绝存储登录 cookie
NUXT_COOKIE_SECURE=false
